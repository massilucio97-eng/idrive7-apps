{
  "id": "mas_mappa_larga",
  "title": "Mappa larga",
  "description": "La mappa del telefono (Maps on cluster) più grande sul quadro: un rettangolo tra i due archi, sopra la velocità digitale e il consumo di BMW, mai sopra gli archi, la barra in basso o le spie. Con la riga di arrivo del percorso CarPlay. Si regola da fermi con la griglia di prova. Richiede Maps on cluster (robertnisipeanu/idrive-apps).",
  "version": "0.1.0",
  "vendor": "mas",
  "loggingId": "MSM1",
  "mguHmi": [
    "ID7"
  ],
  "mguAppStartType": "autostart",
  "internet": false,
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "_optional": "the speed: the test grid only while parked",
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.a4a.carplay.CarPlayManager": {
      "_optional": "whether CarPlay is guiding (the arrival line)",
      "_instances": "CarPlayManagerInst1",
      "projectedGuidanceActive": "rs"
    },
    "de.bmw.infotainment.navigation.guiding.GuidanceEventList": {
      "_optional": "the arrival line: the phone's route events (distance to the destination)",
      "_instances": "Main_Instance",
      "_methods": [
        "queryContent"
      ]
    }
  },
